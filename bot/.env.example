# ============================================================
# Vera Bot — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# LLM Provider: "gemini" | "openai" | "anthropic" | "groq" | "deepseek"
LLM_PROVIDER=gemini

# Your API key for the chosen provider
LLM_API_KEY=

# Optional: override the default model for your provider
# Gemini default:    gemini-2.0-flash
# OpenAI default:    gpt-4o-mini
# Anthropic default: claude-3-5-haiku-20241022
# Groq default:      llama-3.1-70b-versatile
# DeepSeek default:  deepseek-chat
LLM_MODEL=  gemini-2.0-flash

# Your team name (shown in /v1/metadata)
TEAM_NAME=Team Vera

# Team members (comma-separated)
TEAM_MEMBERS=Alice,Bob

# Contact email
CONTACT_EMAIL=team@example.com

# Bot version
BOT_VERSION=1.0.0

# Server port (default 8080)
PORT=8080
